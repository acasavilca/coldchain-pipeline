# secrets / credentials
.aws/
.codex/
.agents/
.env
.env.*
*.pem
*.key
keyfile*.json
service-account*.json
application_default_credentials.json
profiles.yml
secrets/
*.tfstate*

# dbt artifacts
dbt_project/target/
dbt_project/logs/
dbt_project/dbt_packages/
dbt_project/baseline_run_results.json
.user.yml

# simulator outputs (a single chunk is several GB)
run_outputs/
selected_run_outputs/
raw_parquets/
simulation/runs/
plots/
*_run/
simulation/validation/
*.npz
*.parquet
# the per-location weather caches (simulation/weather/location_<id>/) are small (~150 KB) inputs that run.py reads
!weather_data.parquet
!raw_weather_data.parquet
*.pkl
*.h5
*.feather

# simulator state and generated build artifacts (recreated on the first run)
state.npz
rng_state.json
refrigerants_key_resolver.json

# python / numba caches
__pycache__/
*.pyc
*.nbi
*.nbc
.numba_cache/
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
*.egg-info/

# dashboard (Evidence.dev) build output
node_modules/
.evidence/
.svelte-kit/

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# local backups and scratch
*.bak
*.bak.*
*.tgz
*.zip
*.log

# personal / local-only
dbt_project/notes

# generated weather caches: only location 1 is committed (so the repo runs offline)
simulation/weather/location_*/
!simulation/weather/location_1/

# README images: only the ones the README uses are committed (others stay local)
docs/img/*
!docs/img/header.jpg
!docs/img/hero-power-dark.png
!docs/img/hero-power-light.png
